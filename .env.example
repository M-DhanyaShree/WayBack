# ==============================================================================
# WayBack — Root Environment Configuration Reference
# ==============================================================================

# Backend Configuration (Place in backend/.env)
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://wayback:password@localhost:5432/wayback_db?schema=public
JWT_SECRET=replace_with_strong_jwt_access_secret_min_32_chars
JWT_EXPIRES_IN=30m
JWT_REFRESH_SECRET=replace_with_strong_jwt_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Optional Third-Party Services
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
ORS_API_KEY=your_openrouteservice_api_key

# Frontend Configuration (Optional, place in frontend/.env)
VITE_API_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000
