# ==============================================================================
# WayBack Backend Environment Configuration Example
# Copy this file to `backend/.env` and replace placeholder values with your own.
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000

# PostgreSQL Database Connection String
# Format: postgresql://<username>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL=postgresql://wayback:password@localhost:5432/wayback_db?schema=public

# JWT Authentication
# Replace with cryptographically strong secrets in production (e.g., openssl rand -hex 32)
JWT_SECRET=replace_with_strong_jwt_access_secret_min_32_chars
JWT_EXPIRES_IN=30m
JWT_REFRESH_SECRET=replace_with_strong_jwt_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origin (Frontend client URL)
CLIENT_URL=http://localhost:5173

# Cloudinary (Proof of Delivery photo uploads & bill of lading documents)
# Get credentials at https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# OpenRouteService (Turn-by-turn routing and highway distance geometry)
# Sign up for a free key at https://openrouteservice.org/
ORS_API_KEY=your_openrouteservice_api_key
