    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "onnxruntime-node": "^1.17.0",
    "socket.io": "^4.7.1",
    "streamifier": "^0.1.1",
    "swagger-ui-express": "^5.0.0",
    "winston": "^3.10.0",
    "yamljs": "^0.3.0",
    "zod": "^3.21.4"
